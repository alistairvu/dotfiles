# whitelist: only allow certain apps to be managed by yabai
WHITELIST=(
    "Safari"
    "Helium"
    "Zen"
    "Dia"
    "Anki"
    "Todoist"
    "Zed"
    "Ghostty"
    "Mattermost"
    "Zotero"
    "Antinote"
    "Preview"
    "Notion"
    "Notion Calendar"
    "Obsidian"
    "Linear"
    "Microsoft Word"
    "Microsoft Excel"
    "Microsoft PowerPoint"
    "Microsoft Outlook"
    "calibre"
    "Mailspring"
)
WHITELIST_STRING=$(IFS="|"; echo "${WHITELIST[*]}")
yabai -m rule --add app!="^$WHITELIST_STRING\$" manage=off

# explicitly omitting Spotify??
yabai -m rule --add app="^Spotify$" manage=off

# window rules for apps
yabai -m rule --add app="^Linear$" display=west
yabai -m rule --add app="^Microsoft Outlook$" display=west
yabai -m rule --add app="^Spotify$" display=west
yabai -m rule --add app="^Mattermost$" display=west
yabai -m rule --add app="^Signal$" display=west
yabai -m rule --add app="^Zalo\$" display=west

# https://github.com/asmvik/yabai/issues/1317
# Source the file containing persistent rules
source "$HOME/.config/yabai/persistent_rules.sh"

yabai -m signal --add event=window_created action='
  RULES_FILE="$HOME/.config/yabai/persistent_rules.sh"

  window_info=$(yabai -m query --windows --window $YABAI_WINDOW_ID)

  can_resize=$(echo "$window_info" | jq ".[\"can-resize\"]")
  [ "$can_resize" != "false" ] && exit 0

  app=$(echo "$window_info" | jq -r ".app")
  title=$(echo "$window_info" | jq -r ".title")

  [ -z "$app" ] && exit 0
  [ -z "$title" ] && exit 0

  rule_string=$(printf "yabai -m rule --add app=\"%s\" title=\"%s\" manage=off" "$app" "$title")

  grep -qF "$rule_string" "$RULES_FILE" && exit 0

  yabai -m rule --add app="$app" title="$title" manage=off
  printf "%s\\n" "$rule_string" >> "$RULES_FILE"
'

yabai -m rule --add title=' Preferences$' manage=off

# off for Outlook
yabai -m rule --add title='^Accounts$' app='^Microsoft Outlook$' manage=off

