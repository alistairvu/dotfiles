// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run the `open default settings` command
// from the command palette or from `Zed` application menu.
{
  //"base_keymap": "VSCode",
  "disable_ai": false,
  "edit_predictions": {
    "provider": "zed",
    "codestral": {
      "api_url": "https://codestral.mistral.ai",
      "max_tokens": 150,
    },
    "mode": "eager",
  },
  "agent_servers": {
    "claude": {
      "default_model": "sonnet",
      "favorite_models": ["sonnet"],
      "default_config_options": {},
      "favorite_config_option_values": {},
    },
  },
  "title_bar": {
    "show_menus": false,
  },
  "toolbar": {
    "quick_actions": true,
    "breadcrumbs": true,
  },
  "icon_theme": "Catppuccin Mocha",
  "agent": {
    "default_model": {
      "provider": "zed.dev",
      "model": "claude-sonnet-4-5"
    },
    "dock": "left",
    "show_turn_stats": true,
    "favorite_models": [],
    "model_parameters": [],
  },
  "terminal": {
    "toolbar": {
      "breadcrumbs": false,
    },
    "env": {
      "FIG_NEW_SESSION": "\"1\"",
    },
    "font_size": 16.0,
  },
  "project_panel": {
    "dock": "right",
    "auto_fold_dirs": false,
  },
  "base_keymap": "VSCode",
  "gutter": {
    "line_numbers": true,
  },
  "minimap": {
    "show": "never",
  },
  "cursor_blink": true,
  "buffer_font_fallbacks": [
    "FiraCode Nerd Font",
    "Fira Code",
    "Monaco",
    "Menlo",
    "monospace",
    "Courier New",
  ],
  "file_types": {
    "markdown": ["*.rmd"],
    "xml": ["*.fxml"],
    "arm": ["*.as"],
    "pip-requirements": ["**/requirements{/**,*}.{txt,in}"],
    "zmodel": ["*.zmodel"],
    "erb": ["*.erb"],
    "html": ["**/*.html", "*.html"],
    "jinja-html": ["*.jinja", "*.tera"],
    "python": ["*.pyx"],
  },
  "linked_edits": true,
  "show_edit_predictions": true,
  "wrap_guides": [80, 100],
  "soft_wrap": "none",
  "hard_tabs": false,
  "tab_size": 2,
  "theme": "One Dark Pro Darker",
  "buffer_font_size": 16.0,
  "buffer_font_family": "VictorMono Nerd Font Mono",
  "vim_mode": true,
  "format_on_save": "on",
  "languages": {
    "Python": {
      "tab_size": 4,
    },
    "JavaScript": {
      "formatter": {
        "external": {
          "command": "prettier",
          "arguments": ["--stdin-filepath", "{buffer_path}"],
        },
      },
    },
  },

  "lsp": {
    "clangd": {
      "binary": {
        "path": "clangd",
        "arguments": ["--header-insertion=never"],
      },
    },
  },
}
