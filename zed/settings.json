// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run the `open default settings` command
// from the command palette or from `Zed` application menu.
{
  //"base_keymap": "VSCode",
  "cli_default_open_behavior": "new_window",
  "session": {
    "trust_all_worktrees": true,
  },
  "buffer_font_weight": 300.0,
  "ssh_connections": [
    {
      "host": "sudachi",
      "args": [],
      "projects": [
        {
          "paths": ["/home/alistair"],
        },
        {
          "paths": ["/home/alistair/code/./"],
        },
        {
          "paths": ["/home/alistair/code/batman-linux"],
        },
        {
          "paths": ["/home/alistair/code/dynamic-list"],
        },
        {
          "paths": ["/home/alistair/code/f4-test"],
        },
        {
          "paths": ["/home/alistair/code/json-base-fuzzer"],
        },
        {
          "paths": ["/home/alistair/code/tex-fuzzer"],
        },
        {
          "paths": ["/home/alistair/code/yacc"],
        },
      ],
    },
  ],
  "ui_font_family": "Maple Mono NF",
  "ui_font_size": 14.0,
  "disable_ai": false,
  "edit_predictions": {
    "ollama": {
      "model": "qwen2.5-coder:3b",
    },
    "open_ai_compatible_api": {
      "prompt_format": "infer",
      "model": "zed-industries-zeta-4bit",
      "api_url": "http://0.0.0.0:6960/v1",
    },
    "provider": "zed",
    "mode": "eager",
  },
  "agent_servers": {
    "github-copilot-cli": {
      "type": "registry",
    },
    "pi-acp": {
      "type": "registry",
    },
    "claude-acp": {
      "type": "registry",
      "default_model": "sonnet",
      "favorite_models": ["sonnet"],
    },
  },
  "title_bar": {
    "show_menus": false,
  },
  "toolbar": {
    "quick_actions": true,
    "breadcrumbs": true,
  },
  "icon_theme": {
    "mode": "dark",
    "light": "Catppuccin Mocha",
    "dark": "Catppuccin Mocha",
  },
  "agent": {
    "default_model": {
      "provider": "zed.dev",
      "model": "claude-sonnet-4-5",
    },
    "dock": "left",
    "show_turn_stats": true,
    "favorite_models": [],
    "model_parameters": [],
  },
  "terminal": {
    "toolbar": {
      "breadcrumbs": false,
    },
    "font_size": 15.0,
    "shell": "system",
    "cursor_shape": "bar",
    "font_features": {
      "calt": true,
      "cv03": true,
      "cv09": true,
      "cv10": true,
      "cv66": true,
      "cv38": true,
      "cv42": true,
      "cv43": true,
      "ss03": true,
      "ss10": true,
    },
  },
  "project_panel": {
    "dock": "right",
    "auto_fold_dirs": false,
  },
  "base_keymap": "VSCode",
  "gutter": {
    "line_numbers": true,
  },
  "minimap": {
    "show": "never",
  },
  "cursor_blink": true,
  "buffer_font_fallbacks": [
    "FiraCode Nerd Font",
    "Monaco",
    "Menlo",
    "Courier New",
  ],
  "file_types": {
    "markdown": ["*.rmd"],
    "xml": ["*.fxml"],
    "arm": ["*.as"],
    "pip-requirements": ["**/requirements{/**,*}.{txt,in}"],
    "zmodel": ["*.zmodel"],
    "erb": ["*.erb"],
    "html": ["**/*.html", "*.html"],
    "jinja-html": ["*.jinja", "*.tera"],
    "python": ["*.pyx"],
    "Shell Script": ["yabairc", "skhdrc", "*.fish"],
    "JSONC": ["**/zed/settings.json"],
  },
  "linked_edits": true,
  "show_edit_predictions": true,
  "wrap_guides": [80, 100],
  "soft_wrap": "none",
  "hard_tabs": false,
  "tab_size": 2,
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Catppuccin Mocha (Blue Blur+)",
  },
  "buffer_font_size": 15.0,
  "buffer_font_family": "Maple Mono NF",
  "buffer_font_features": {
    "calt": true,
    "cv03": true,
    "cv09": true,
    "cv10": true,
    "cv66": true,
    "cv38": true,
    "cv42": true,
    "cv43": true,
    "ss03": true,
    "ss10": true,
  },
  "ui_font_features": {
    "calt": true,
    "cv03": true,
    "cv09": true,
    "cv10": true,
    "cv66": true,
    "cv38": true,
    "cv42": true,
    "cv43": true,
    "ss03": true,
    "ss10": true,
  },
  "vim_mode": true,
  "format_on_save": "on",
  "languages": {
    "Make": {
      "hard_tabs": true,
    },
    "Python": {
      "tab_size": 4,
    },
    "Zig": {
      "tab_size": 4,
    },
    "JavaScript": {
      "formatter": {
        "external": {
          "command": "prettier",
          "arguments": ["--stdin-filepath", "{buffer_path}"],
        },
      },
    },
  },

  "lsp": {
    "clangd": {
      "binary": {
        "path": "clangd",
        "arguments": ["--header-insertion=never"],
      },
    },
  },
  "experimental.theme_overrides": {
    "syntax": {
      "comment": {
        "font_style": "italic",
      },
    },
  },
  "relative_line_numbers": "enabled",
  "restore_on_startup": "launchpad",
  "diagnostics": {
    "inline": {
      "enabled": true,
      "max_severity": null, // same values as the `diagnostics_max_severity` from the editor settings
    },
  },
  "when_closing_with_no_tabs": "close_window",
}
